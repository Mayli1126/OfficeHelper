# ── 厂商选择 ──────────────────────────────────────────────
# 可选：dashscope（默认）/ openai / ollama / zhipu
OFFICEMATE_LLM_PROVIDER=dashscope

# ── 密钥 ──────────────────────────────────────────────────
# 根据选择的厂商配置对应密钥（ollama 不需要密钥）
DASHSCOPE_API_KEY=sk-e0d7a03e0fa9491090b0bb1885800fa4

# ── Base URL ──────────────────────────────────────────────
# 全局统一配置（所有厂商生效，注释掉则用各厂商默认值）
# OFFICEMATE_BASE_URL=https://api.openai.com/v1
# 按厂商分别配置（优先级高于全局）
OFFICEMATE_DASHSCOPE_BASE_URL=https://llm-j8sr1bzce3wv47bd.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# ── 模型名称 ──────────────────────────────────────────────
OFFICEMATE_CHAT_MODEL=qwen3.8-max
OFFICEMATE_EMBEDDING_MODEL=text-embedding-v4

# ── 检索配置 ──────────────────────────────────────────────
OFFICEMATE_RETRIEVAL_CANDIDATES=12
OFFICEMATE_RETRIEVAL_RESULTS=4
OFFICEMATE_MIN_RELEVANCE=0.30
OFFICEMATE_VECTOR_WEIGHT=0.65
OFFICEMATE_RRF_K=60
OFFICEMATE_BM25_K1=1.5
OFFICEMATE_BM25_B=0.75
OFFICEMATE_BM25_SATURATION=3.0
OFFICEMATE_VECTOR_DISTANCE_SCALE=2.0

# ── 语义分块 ──────────────────────────────────────────────
OFFICEMATE_CHUNK_MIN_SIZE=150

# ── Cross-Encoder 精排 ────────────────────────────────────
OFFICEMATE_ENABLE_RERANKER=true
OFFICEMATE_RERANKER_MODEL=BAAI/bge-reranker-v2-zh
OFFICEMATE_RERANKER_TOP_K=8

# ── 查询改写 ──────────────────────────────────────────────
OFFICEMATE_ENABLE_QUERY_REWRITE=true
OFFICEMATE_MAX_QUERY_VARIANTS=3

# ── 查询分解 ──────────────────────────────────────────────
OFFICEMATE_ENABLE_QUERY_DECOMPOSE=true
OFFICEMATE_MAX_SUB_QUERIES=4

# ── 多 Embedding 融合 ─────────────────────────────────────
OFFICEMATE_EMBEDDING2_MODEL=
OFFICEMATE_EMBEDDING2_WEIGHT=0.20

# ── 语义路由 ──────────────────────────────────────────────
OFFICEMATE_ENABLE_SEMANTIC_ROUTE=true
OFFICEMATE_SEMANTIC_ROUTE_THRESHOLD=0.5

# ── LangGraph 工作流 ──────────────────────────────────────
OFFICEMATE_ENABLE_LANGGRAPH=true
OFFICEMATE_MAX_WORKFLOW_RETRIES=2